# Application Configuration
spring.application.name=tienda-backend

# Database Configuration (PostgreSQL)
# Update these values with your actual database credentials
spring.datasource.url=jdbc:postgresql://localhost:5432/tienda_db?sslmode=require
spring.datasource.username=your_db_username
spring.datasource.password=your_db_password

# Hibernate Configuration
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true

# Bot de Telegram
# Deshabilitado por defecto: un token admite un solo consumidor, asi que se
# habilita de forma explicita y con un bot distinto por entorno (dev/prod).
telegram.bot.habilitado=false
telegram.bot.token=${TELEGRAM_BOT_TOKEN:}
# POLLING (no requiere URL publica) o WEBHOOK (requiere HTTPS publico)
telegram.bot.modo=POLLING
# Solo en modo WEBHOOK: URL publica completa del endpoint POST /telegram/webhook
# y secret (1-256 caracteres A-Z a-z 0-9 _ -) que Telegram envia en cada peticion
telegram.bot.webhook.url=https://tu-dominio-publico/telegram/webhook
telegram.bot.webhook.secret=${TELEGRAM_WEBHOOK_SECRET:}

# Almacenamiento de archivos (notas de voz del bot)
almacenamiento.local.directorio=./data/archivos

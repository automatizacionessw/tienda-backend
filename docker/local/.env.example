# Variables del entorno local (opcional).
# Copiar como docker/local/.env (ignorado por git). Sin este archivo se
# levanta el modo desarrollo con los valores por defecto.

# --- Modo completo -----------------------------------------------------------
# Descomentar AMBAS lineas para levantar tambien el backend en un contenedor.
# Detener antes el backend del IDE: los dos usan el puerto 8080.
#COMPOSE_PROFILES=completo
#TIENDA_BACKEND_URL=http://backend:8080

# --- Puertos del host (solo en 127.0.0.1) -----------------------------------
# Cambiarlos si ya estan ocupados en tu maquina. Si cambias LOCAL_DB_PORT,
# ajusta tambien spring.datasource.url en application-local.properties.
#LOCAL_DB_PORT=5432
#LOCAL_N8N_PORT=5678
#LOCAL_BACKEND_PORT=8080

# --- Bot de Telegram (solo modo completo, siempre en POLLING) ---------------
# Usar un bot distinto al del despliegue y no correrlo a la vez desde el IDE:
# un token admite un solo consumidor.
#TELEGRAM_BOT_ENABLED=true
#TELEGRAM_BOT_TOKEN=

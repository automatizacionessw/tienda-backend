# Variables del despliegue con Docker Compose.
# - Dokploy: cargarlas en la pestana Environment del servicio (Dokploy escribe
#   docker/.env al desplegar).
# - Prueba local: copiar este archivo como docker/.env (ignorado por git).

# --- Base de datos (OBLIGATORIAS) -------------------------------------------
# El backend se conecta con estas mismas credenciales al servicio "db".
POSTGRES_DB=tienda_db
POSTGRES_USER=tienda
POSTGRES_PASSWORD=cambiar-por-una-contrasena-segura

# --- JPA / Hibernate ----------------------------------------------------------
# Estrategia de esquema: update (por defecto), validate, none...
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# --- Acceso al backend -------------------------------------------------------
# El backend no tiene dominio publico: se publica solo en esta IP del host.
# Usar la IP INTERNA del servidor (Swagger y API desde la red interna).
# Sin valor, solo 127.0.0.1 (accesible unicamente desde el propio servidor).
# Nunca usar 0.0.0.0 ni la IP publica: la API no tiene autenticacion.
BACKEND_BIND_IP=
# Puerto del host para el backend (por defecto 8080).
BACKEND_HOST_PORT=8080

# --- Bot de Telegram --------------------------------------------------------
# Usar un bot distinto por entorno: un token admite un solo consumidor.
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
# POLLING (recomendado en este despliegue) o WEBHOOK
TELEGRAM_BOT_MODE=POLLING
# Solo en modo WEBHOOK, que requiere exponer el backend a internet y no aplica
# a este despliegue: https://<tu-dominio>/telegram/webhook y un secret
# de 1-256 caracteres A-Z a-z 0-9 _ -
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# --- Documentacion de la API (OpenAPI / Swagger UI) -------------------------
# La API no tiene autenticacion: mantener en false en produccion.
API_DOCS_ENABLED=false

# --- n8n (automatizaciones) -------------------------------------------------
# Clave con la que n8n cifra las credenciales guardadas (OBLIGATORIA).
# Generarla una sola vez, por ejemplo con: openssl rand -hex 32
# No cambiarla despues del primer deploy: las credenciales guardadas dejarian
# de poder descifrarse. Guardarla junto a los demas secretos.
N8N_ENCRYPTION_KEY=
# Dominio publico de n8n, sin https:// ni barra final (OBLIGATORIA).
# En Dokploy, agregar este dominio apuntando al servicio n8n, puerto 5678.
N8N_HOST=n8n.tu-dominio.com
# Zona horaria de n8n (Schedule Trigger y logs). Por defecto UTC.
N8N_TIMEZONE=UTC
